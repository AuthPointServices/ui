{
  "name": "@authpoint/ui",
  "version": "0.1.0",
  "description": "El sistema de diseño de Seedle: los tokens y el comportamiento de Adobe Spectrum 2 con la identidad Seedle.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "prepare": "pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && node scripts/tokens.mjs --verify"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "lucide-react": "1.73.0",
    "react-aria-components": "1.22.1"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@adobe/spectrum-tokens": "15.7.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.9"
  }
}
